{
  "name": "asprossh",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "out/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "npm install",
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && vite build && vite build -c vite.main.config.ts && vite build -c vite.preload.config.ts",
    "start": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "rebuild:native": "node ./scripts/rebuild-native.mjs",
    "postinstall": "npm run rebuild:native",
    "verify": "npm run typecheck",
    "rebuild:native:force": "node ./scripts/rebuild-native.mjs --force",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "@tailwindcss/vite": "^4.0.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-unicode11": "^0.8.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ssh2": "^1.16.0",
    "tailwindcss": "^4.0.0",
    "@xterm/addon-search": "^0.15.0",
    "uplot": "^1.6.31"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "electron": "37.4.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ssh2": "^1.15.5",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "productName": "ASProSSH",
  "description": "Desktop SSH, SFTP, server monitoring, PowerShell, CMD, and WSL workspace built with Electron and React."
}
